# Upstream group-project exclusions, retained alongside selected-result rules.
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Datasets
data/raw/*
data/processed/*

# Keep dataset documentation
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Trained models / checkpoints
*.pt
*.pth
*.ckpt
*.h5
*.keras

# Experiment outputs
runs/
wandb/
tensorboard/

# Temporary files
*.tmp
*.log

# Python packaging
build/
dist/
*.egg-info/

# Environment variables
.env
.env.*

# LaTeX build files
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Generated reports
report/*.pdf


/data/raw/

notes.md

# Python, environments and notebooks
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.conda/
*.egg-info/
build/
dist/

# Model weights, resume checkpoints and temporary workspace files stay local.
*.pt
*.pth
*.ckpt
/tmp/

