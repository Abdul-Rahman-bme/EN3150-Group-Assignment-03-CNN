e","source":"class DSBlock(nn.Module):\n    def __init__(self, cin, cout, stride=1):\n        super().__init__()\n        self.skip = stride == 1 and cin == cout\n        self.layers = nn.Sequential(\n            nn.Conv2d(cin, cin, 3, stride, 1, groups=cin, bias=False),\n            nn.BatchNorm2d(cin), nn.ReLU(inplace=True),\n            nn.Conv2d(cin, cout, 1, bias=False),\n            nn.BatchNorm2d(cout),\n        )\n        self.relu = nn.ReLU(inplace=True)\n    def forward(self, x):\n        y = self.layers(x)\n        if self.skip:\n            y = y + x\n        return self.relu(y)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:37.431634Z","iopub.execute_input":"2026-10-14T04:08:37.432064Z","iopub.status.idle":"2026-10-14T04:08:37.437995Z","shell.execute_reply.started":"2026-10-14T04:08:37.432038Z","shell.execute_reply":"2026-10-14T04:08:37.437238Z"}},"outputs":[],"execution_count":22},{"cell_type":"code","source":"class CompactEuroSAT(nn.Module):\n    def __init__(self, num_classes=10):\n        super().__init__()\n        self.features = nn.Sequential(\n            nn.Conv2d(3, 16, 3, padding=1, bias=False),\n            nn.BatchNorm2d(16), nn.ReLU(inplace=True),\n            DSBlock(16, 32, 2),  # 32 x 32 x 32\n            DSBlock(32, 48, 2),  # 48 x 16 x 16\n            DSBlock(48, 48),     # Residual; 48 x 16 x 16\n            DSBlock(48, 80, 2),  # 80 x 8 x 8\n        )\n        self.head = nn.Sequential(\n            nn.AdaptiveAvgPool2d(1), nn.Flatten(),\n            nn.Dropout(0.10), nn.Linear(80, num_classes),\n        )\n    def forward(self, x):\n        return self.head(self.features(x))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:39.565535Z","iopub.execute_input":"2026-10-14T04:08:39.565978Z","iopub.status.idle":"2026-10-14T04:08:39.572468Z","shell.execute_reply.started":"2026-10-14T04:08:39.56595Z","shell.execute_reply":"2026-10-14T04:08:39.571685Z"}},"outputs":[],"execution_c