y.shape[1]\nmean = channel_sum / pixels\nstd = np.sqrt(np.maximum(channel_sq / pixels - mean ** 2, 1e-12))\nprint('Training mean:', mean, '| std:', std)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:07:33.862902Z","iopub.execute_input":"2026-10-14T04:07:33.863534Z","iopub.status.idle":"2026-10-14T04:07:51.238026Z","shell.execute_reply.started":"2026-10-14T04:07:33.863506Z","shell.execute_reply":"2026-10-14T04:07:51.237274Z"}},"outputs":[{"name":"stdout","text":"Training mean: [0.3444954  0.38034746 0.40780443] | std: [0.20310571 0.13712056 0.11566022]\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"class RandomQuarterTurn:\n    def __call__(self, image):\n        return image.rotate(90 * random.randrange(4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:06.935122Z","iopub.execute_input":"2026-10-14T04:08:06.935458Z","iopub.status.idle":"2026-10-14T04:08:06.939755Z","shell.execute_reply.started":"2026-10-14T04:08:06.935431Z","shell.execute_reply":"2026-10-14T04:08:06.939045Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"train_tf = T.Compose([\n    T.RandomHorizontalFlip(), T.RandomVerticalFlip(),\n    RandomQuarterTurn(),\n    T.ColorJitter(brightness=0.10, contrast=0.10, saturation=0.10),\n    T.ToTensor(), T.Normalize(mean.tolist(), std.tolist()),\n])\n\neval_tf = T.Compose([\n    T.ToTensor(), T.Normalize(mean.tolist(), std.tolist()),\n])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:10.080192Z","iopub.execute_input":"2026-10-14T04:08:10.080577Z","iopub.status.idle":"2026-10-14T04:08:10.085667Z","shell.execute_reply.started":"2026-10-14T04:08:10.080551Z","shell.execute_reply":"2026-10-14T04:08:10.084926Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"class EuroSATDataset(Dataset):\n    def __init__(self, frame, transform):\n        self.paths = frame.path.tolist()\n        self.labels = frame.label.tolist()\n        self.transform = transform\n    def __len__(self):\n        return len(self.paths)\n    def __getitem__(self, index):\n        with Image.open(self.paths[index]) as im:\n            image = self.transform(im.convert('RGB'))\n        return image, self.labels[index]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:29.123808Z","iopub.execute_input":"2026-10-14T04:08:29.124258Z","iopub.status.idle":"2026-10-14T04:08:29.129592Z","shell.execute_reply.started":"2026-10-14T04:08:29.124231Z","shell.execute_reply":"2026-10-14T04:08:29.128941Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"def seed_worker(worker_id):\n    worker_seed = torch.initial_seed() % (2 ** 32)\n    np.random.seed(worker_seed)\n    random.seed(worker_seed)\ndef make_loader(frame, transform, shuffle):\n    return DataLoader(\n        EuroSATDataset(frame, transform), batch_size=BATCH_SIZE,\n        shuffle=shuffle, num_workers=NUM_WORKERS,\n        pin_memory=(device.type == 'cuda'), worker_init_fn=seed_worker,\n        generator=torch.Generator().manual_seed(SEED))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:31.300417Z","iopub.execute_input":"2026-10-14T04:08:31.300826Z","iopub.status.idle":"2026-10-14T04:08:31.305842Z","shell.execute_reply.started":"2026-10-14T04:08:31.3008Z","shell.execute_reply":"2026-10-14T04:08:31.305115Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"train_loader = make_loader(train_df, train_tf, True)\nval_loader = make_loader(val_df, eval_tf, False)\ntest_loader = make_loader(test_df, eval_tf, False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:33.702579Z","iopub.execute_input":"2026-10-14T04:08:33.703017Z","iopub.status.idle":"2026-10-14T04:08:33.70954Z","shell.execute_reply.started":"2026-10-14T04:08:33.702988Z","shell.execute_reply":"2026-10-14T04:08:33.708928Z"}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"class DSBlock(nn.Module):\n    def __init__(self, cin, cout, stride=1):\n        super().__init__()\n        self.skip = stride == 1 and cin == cout\n        self.layers = nn.Sequential(\n            nn.Conv2d(cin, cin, 3, stride, 1, groups=cin, bias=False),\n            nn.BatchNorm2d(cin), nn.ReLU(inplace=True),\n            nn.Conv2d(cin, cout, 1, bias=False),\n            nn.BatchNorm2d(cout),\n        )\n        self.relu = nn.ReLU(inplace=True)\n    def forward(self, x):\n        y = self.layers(x)\n        if self.skip:\n            y = y + x\n        return self.relu(y)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:37.431634Z","iopub.execute_input":"2026-10-14T04:08:37.432064Z","iopub.status.idle":"2026-10-14T04:08:37.437995Z","shell.execute_reply.started":"2026-10-14T04:08:37.432038Z","shell.execute_reply":"2026-10-14T04:08:37.437238Z"}},"outputs":[],"execution_count":22},{"cell_type":"code","source":"class CompactEuroSAT(nn.Module):\n    def __init__(self, num_classes=10):\n        super().__init__()\n        self.features = nn.Sequential(\n            nn.Conv2d(3, 16, 3, padding=1, bias=False),\n            nn.BatchNorm2d(16), nn.ReLU(inplace=True),\n            DSBlock(16, 32, 2),  # 32 x 32 x 32\n            DSBlock(32, 48, 2),  # 48 x 16 x 16\n            DSBlock(48, 48),     # Residual; 48 x 16 x 16\n            DSBlock(48, 80, 2),  # 80 x 8 x 8\n        )\n        self.head = nn.Sequential(\n            nn.AdaptiveAvgPool2d(1), nn.Flatten(),\n            nn.Dropout(0.10), nn.Linear(80, num_classes),\n        )\n    def forward(self, x):\n        return self.head(self.features(x))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:39.565535Z","iopub.execute_input":"2026-10-14T04:08:39.565978Z","iopub.status.idle":"2026-10-14T04:08:39.572468Z","shell.execute_reply.started":"2026-10-14T04:08:39.56595Z","shell.execute_reply":"2026-10-14T04:08:39.571685Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"seed_everything(SEED)\nmodel = CompactEuroSAT(K).to(device)\nparams = sum(p.numel() for p in model.parameters())\nprint(f'Parameters: {params:,}; FP32 parameter bytes: {4 * params:,}')\nassert params == 11466, 'The intended 10-class model has 11,466 params.'\nwith torch.no_grad():\n    model.eval()\n    assert model(torch.zeros(2, 3, 64, 64, device=device)).shape == (2, K)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:41.556142Z","iopub.execute_input":"2026-10-14T04:08:41.556532Z","iopub.status.idle":"2026-10-14T04:08:42.586735Z","shell.execute_reply.started":"2026-10-14T04:08:41.556506Z","shell.execute_reply":"2026-10-14T04:08:42.585944Z"}},"outputs":[{"name":"stdout","text":"Parameters: 11,466; FP32 parameter bytes: 45,864\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"#Count convolution + linear MACs for ONE 64x64 image.\n# BN, activations, pooling, additions and memory access are excluded.\nmacs = 0\ndef count_macs(layer, inputs, output):\n    global macs\n    if isinstance(layer, nn.Conv2d):\n        kh, kw = layer.kernel_size\n        macs += output.numel() * (layer.in_channels // layer.groups) * kh * kw\n    elif isinstance(layer, nn.Linear):\n        macs += output.numel() * layer.in_features\nhooks = [m.register_forward_hook(count_macs) for m in model.modules()\n         if isinstance(m, (nn.Conv2d, nn.Linear))]\nwith torch.inference_mode():\n    model(torch.zeros(1, 3, 64, 64, device=device))\nfor hook in hooks:\n    hook.remove()\nassert macs == 3882784\nprint(f'Conv + linear MACs/image: {macs:,}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:09:07.168104Z","iopub.execute_input":"2026-10-14T04:09:07.16879Z","iopub.status.idle":"2026-10-14T04:09:07.201773Z","shell.execute_reply.started":"2026-10-14T04:09:07.168743Z","shell.execute_reply":"2026-10-14T04:09:07.201079Z"}},"outputs":[{"name":"stdout","text":"Conv + linear MACs/image: 3,882,784\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"# %% 8. Training setup\n\n# Output directory\nrun_dir = OUT\nrun_dir.mkdir(parents=True, exist_ok=True)\n\n# Class weights\nif USE_WEIGHTED_LOSS:\n    weights = torch.tensor(\n        len(train_df) / (K * train_counts),\n        dtype=torch.float32,\n        device=device\n    )\nelse:\n    weights = torch.ones(K, dtype=torch.float32, device=device)\n\n# Loss function\n# reduction='none' is required by your training loop\ncriterion = nn.CrossEntropyLoss(\n    weight=weights,\n    reduction='none'\n)\n\n# Optimizer\noptimizer = torch.optim.Adam(\n    model.parameters(),\n    lr=LR\n)\n\n# Learning rate scheduler\nscheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n    optimizer,\n    T_max=EPOCHS\n)\n\n# Automatic mixed precision\nuse_amp = device.type == 'cuda'\n\nscaler = torch.amp.GradScaler(\n    device.type,\n    enabled=use_amp\n)\n\nprint(\"Training setup completed!\")\nprint(\"Optimizer: Adam\")\nprint(\"Learning rate:\", LR)\nprint(\"Weighted loss:\", USE_WEIGHTED_LOSS)\nprint(\"Mixed precision:\", use_amp)\nprint(\"Device:\", device)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:16:16.418544Z","iopub.execute_input":"2026-10-14T04:16:16.419046Z","iopub.status.idle":"2026-10-14T04:16:16.4282Z","shell.execute_reply.started":"2026-10-14T04:16:16.419016Z","shell.execute_reply":"2026-10-14T04:16:16.427392Z"}},"outputs":[{"name":"stdout","text":"Training setup completed!\nOptimizer: Adam\nLearning rate: 0.001\nWeighted loss: False\nMixed precision: True\nDevice: cuda\n","output_type":"stream"}],"execution_count":30},{"cell_type":"code","source":"config = {\n    'classes': CLASSES,\n    'mean': mean.tolist(),\n    'std': std.tolist(),\n    'seed': SEED,\n    'weighted': USE_WEIGHTED_LOSS,\n    'weights': weights.cpu().tolist(),\n    'parameters': params,\n    'architecture': 'CompactEuroSAT_11466',\n    'conv_linear_macs': macs,\n   