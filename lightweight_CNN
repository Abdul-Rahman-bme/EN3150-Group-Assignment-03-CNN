{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":1663377}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"Here I am going to build a CNN for classification.\nrequirement is this model should be light weight with fever number of parameters.\nso that we can run this on an edge device.\nso one of the main technique is using the depthwise convolution instead of normal convolution.\nby using depth wise separable convolution we can reduce the number of parametern by the factor of nearly 8\n","metadata":{}},{"cell_type":"code","source":"# Depthwise Separable Convolution:\n\n# Normal convolution:\n# If input has 32 channels and output needs 64 channels:\n# - 64 filters\n# - each filter contains 32 sub-filters\n# - each sub-filter is 3x3\n\n# Parameters = 64 * 32 * 3 * 3\n#            = 18,432\n\n# Depthwise convolution:\n# - Use one 3x3 filter for each input channel\n# - 32 input channels -> 32 separate 3x3 filters\n\n# Parameters = 32 * 3 * 3\n#            = 288\n\n# Output after depthwise convolution still has 32 channels.\n\n# Pointwise convolution:\n# - Used to convert 32 channels into 64 channels\n# - Uses 64 filters\n# - each filter sees all 32 input channels\n# - each sub-filter is only 1x1\n\n# Parameters = 64 * 32 * 1 * 1\n#            = 2,048\n\n# Total parameters for depthwise separable convolution:\n# 288 + 2,048 = 2,336\n\n# Compared with normal convolution:\n# Normal Conv      = 18,432 parameters\n# Depthwise + 1x1 = 2,336 parameters\n\n# Key idea:\n# Normal Conv:\n#   64 filters, each with 32 separate 3x3 sub-filters\n\n# Depthwise Separable Conv:\n#   32 separate 3x3 filters\n#   +\n#   64 pointwise filters, each with 32 separate 1x1 sub-filters","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:02:51.821043Z","iopub.execute_input":"2026-10-14T04:02:51.821414Z","iopub.status.idle":"2026-10-14T04:02:51.826582Z","shell.execute_reply.started":"2026-10-14T04:02:51.821389Z","shell.execute_reply":"2026-10-14T04:02:51.82582Z"}},"outputs":[],"execution_count":1},{"cell_type":"code","source":"from pathlib import Path\nimport hashlib\nimport json\nimport random\nimport time\nimport platform\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom PIL import Image\nimport torch\nfrom torch import nn\nfrom torch.utils.data import Dataset, DataLoader\nimport torchvision\nfrom torchvision import transforms as T\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import (\n    accuracy_score, balanced_accuracy_score, classification_report,\n    confusion_matrix, ConfusionMatrixDisplay,\n    precision_recall_fscore_support,\n)\nfrom tqdm.auto import tqdm","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:02:54.060755Z","iopub.execute_input":"2026-10-14T04:02:54.061343Z","iopub.status.idle":"2026-10-14T04:03:03.13256Z","shell.execute_reply.started":"2026-10-14T04:02:54.061315Z","shell.execute_reply":"2026-10-14T04:03:03.132008Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"SEED = 42\nBATCH_SIZE = 128\nEPOCHS = 60\nPATIENCE = 12\nLR = 0.001\nNUM_WORKERS = 2 \nDATA_ROOT = Path(\"/kaggle/input/datasets/apollo2506/eurosat-dataset/EuroSAT\")\nCSV_DIR = DATA_ROOT\nSPLIT_MODE = \"csv\"\nOUT = Path('/kaggle/working/eurosat_compact')\nOUT.mkdir(parents=True, exist_ok=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:03:05.862104Z","iop