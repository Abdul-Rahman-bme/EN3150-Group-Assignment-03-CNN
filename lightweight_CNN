ch_den = weights[labels].sum()\n                        loss = losses.sum() / batch_den\n                    if training:\n                        scaler.scale(loss).backward()\n                        scaler.unscale_(optimizer)\n                        nn.utils.clip_grad_norm_(model.parameters(), 5.0)\n                        scaler.step(optimizer)\n                        scaler.update()\n                pred = logits.argmax(dim=1)\n                numerator += losses.detach().sum().item()\n                denominator += batch_den.item()\n                correct += (pred == labels).sum().item()\n                total += labels.numel()\n                truth.extend(labels.detach().cpu().tolist())\n                predictions.extend(pred.detach().cpu().tolist())\n                running_acc = correct / total\n                # Validation is unknown until its batches are processed.\n                train_text = (f'{running_acc:.3f}' if training\n                              else f\"{stats['train_acc']:.3f}\")\n                val_text = '--' if training else f'{running_acc:.3f}'\n                bar.set_postfix(phase=phase, train_acc=train_text,\n                                val_acc=val_text,\n                                loss=f'{numerator/denominator:.4f}',\n                                refresh=False)\n                bar.update(1)\n            precision, recall, f1, _ = precision_recall_fscore_support(\n                truth, predictions, labels=list(range(K)),\n                average='macro', zero_division=0)\n            stats.update({\n                f'{phase}_loss': numerator / denominator,\n                f'{phase}_acc': correct / total,\n                f'{phase}_precision': precision,\n                f'{phase}_recall': recall, f'{phase}_f1': f1,\n            })\n        bar.set_postfix(train_acc=f\"{stats['train_acc']:.3f}\",\n                        val_acc=f\"{stats['val_acc']:.3f}\",\n                        val_F1=f\"{stats['val_f1']:.3f}\")\n    stats.update(epoch=epoch, lr=current_lr)\n    history.append(stats)\n    pd.DataFrame(history).to_csv(run_dir / 'history.csv', index=False)\n    if stats['val_f1'] > best_f1 + 1e-6:\n        best_f1 = stats['val_f1']\n        bad_epochs = 0\n        torch.save(model.state_dict(), run_dir / 'best_model.pt')\n        (run_dir / 'best_epoch.json').write_text(json.dumps({'epoch': epoch, 'validation_macro_f1': best_f1}))\n    else:\n        bad_epochs += 1\n    scheduler.step()\n    if bad_epochs >= PATIENCE:\n        print(f'Early stopping; best validation macro-F1 = {best_f1:.4f}')\n        break","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:17:55.661131Z","iopub.execute_input":"2026-10-14T04:17:55.661519Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Epoch 01/60:   0%|          | 0/191 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"e19036c63de54cde9a746a74f71ceebf"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Epoch 02/60:   0%|          | 0/191 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"45c9f1454e7041b0867133c6b0de468a"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Epoch 03/60:   0%|          | 0/191 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d747423e08a94d6fa7b5977dceda226d"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Epoch 04/60:   0%|          | 0/191 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"97af560d17e24be4bed7d470436712aa"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Epoch 05/60:   0%|          | 0/191 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0c9c20b02cbe44359e7da786b4f54cd9"}},"metad