y.shape[1]\nmean = channel_sum / pixels\nstd = np.sqrt(np.maximum(channel_sq / pixels - mean ** 2, 1e-12))\nprint('Training mean:', mean, '| std:', std)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:07:33.862902Z","iopub.execute_input":"2026-10-14T04:07:33.863534Z","iopub.status.idle":"2026-10-14T04:07:51.238026Z","shell.execute_reply.started":"2026-10-14T04:07:33.863506Z","shell.execute_reply":"2026-10-14T04:07:51.237274Z"}},"outputs":[{"name":"stdout","text":"Training mean: [0.3444954  0.38034746 0.40780443] | std: [0.20310571 0.13712056 0.11566022]\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"class RandomQuarterTurn:\n    def __call__(self, image):\n        return image.rotate(90 * random.randrange(4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:06.935122Z","iopub.execute_input":"2026-10-14T04:08:06.935458Z","iopub.status.idle":"2026-10-14T04:08:06.939755Z","shell.execute_reply.started":"2026-10-14T04:08:06.935431Z","shell.execute_reply":"2026-10-14T04:08:06.939045Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"train_tf = T.Compose([\n    T.RandomHorizontalFlip(), T.RandomVerticalFlip(),\n    RandomQuarterTurn(),\n    T.ColorJitter(brightness=0.10, contrast=0.10, saturation=0.10),\n    T.ToTensor(), T.Normalize(mean.tolist(), std.tolist()),\n])\n\neval_tf = T.Compose([\n    T.ToTensor(), T.Normalize(mean.tolist(), std.tolist()),\n])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:08:10.080192Z","iopub.execute_input":"2026-10-14T04:08:10.080577Z","iopub.status.idle":"2026-10-14T04:08:10.085667Z","shell.execute_reply.started":"2026-10-14T04:08:10.080551Z","shell.execute_reply":"2026-10-14T04:08:10.084926Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"class EuroSATDataset(Dataset):\n    def __init__(self, frame, transform):\n        self.paths = frame.path.tolist()\n        self.labels = frame.lab