n\np\nr\ni\nn\nt\n(\ne\nf\nf\ni\nc\ni\ne\nn\nc\ny\n)\n\n(\nr\nu\nn\n_\nd\ni\nr\n \n/\n \n'\ne\nf\nf\ni\nc\ni\ne\nn\nc\ny\n.\nj\ns\no\nn\n'\n)\n.\nw\nr\ni\nt\ne\n_\nt\ne\nx\nt\n(\nj\ns\no\nn\n.\nd\nu\nm\np\ns\n(\ne\nf\nf\ni\nc\ni\ne\nn\nc\ny\n,\n \ni\nn\nd\ne\nn\nt\n=\n2\n)\n)\n\np\nr\ni\nn\nt\n(\n'\nO\nu\nt\np\nu\nt\ns\n \ns\na\nv\ne\nd\n \ni\nn\n:\n'\n,\n \nr\nu\nn\n_\nd\ni\nr\n)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-31","cell_type":"code","source":"# %% 13. Predict one RGB image with the trained model\ndef predict_image(path):\n    with Image.open(path) as image:\n        if image.size != (64, 64):\n            raise ValueError('Use a 64x64 EuroSAT RGB image.')\n        x = eval_tf(image.convert('RGB')).unsqueeze(0).to(device)\n    model.eval()\n    with torch.inference_mode():\n        probability = model(x).softmax(dim=1)[0]\n    index = probability.argmax().item()\n    return CLASSES[index], float(probability[index])","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-32","cell_type":"code","source":"# Optional inference on your own image after training:\n# print(predict_image('/path/to/your/64x64_RGB_image.jpg'))","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-33","cell_type":"code","source":"# Build a report only after a complete new run, using actual saved evidence.\nrequired_files = ['config.json', 'split_evidence.json', 'history.csv', 'best_weights.pt',\n    'best_epoch.json', 'training_time.json', 'validation_metrics.json', 'test_metrics.json',\n    'validation_predictions.csv', 'test_predictions.csv', 'validation_confusion_None.csv',\n    'test_confusion_None.csv', 'validation_confusion_matrices.png',\n    'test_confusion_matrices.png', 'learning_curves.png', 'efficiency.json',\n    'train_manifest.csv', 'validation_manifest.csv', 'test_manifest.csv']\nmissing_artifacts = [name for name in required_files if not (run_dir / name).is_file()]\nif missing_artifacts:\n    raise RuntimeError(f'Incomplete run: {missing_artifacts}')\nsaved_history = pd.read_csv(run_dir / 'history.csv')\nassert saved_history.epoch.tolist() == list(range(1, 31))\nassert int(saved_history.loc[saved_history.val_loss.idxmin(), 'epoch']) == best_epoch['epoch']\ncfg = json.loads((run_dir / 'config.json').read_text())\nv = json.loads((run_dir / 'validation_metrics.json').read_text())\nt = json.loads((run_dir / 'test_metrics.json').read_text())\ncost = json.loads((run_dir / 'efficiency.json').read_text())\ntiming = json.loads((run_dir / 'training_time.json').read_text())\nstatus = 'Verified against the supplied common-protocol checks' if cfg['comparison_ready'] else (\n    'Comparability NOT fully verified: check environment, canonical split identity, and shared preprocessing.')\nreport_lines = [\n    '# CompactEuroSAT experiment', '', status, '',\n    'Architecture: unchanged compact CNN with depthwise-separable convolutions, one residual block,',\n    'global average pooling, dropout 0.10 and a 10-class linear head.',\n    'Originally developed as an additional compact CNN; it does not replace Model B (`model_c`).', '',\n    '## Historical experiment',\n    '94.72% test accuracy, from the original notebook protocol: batch 128, maximum 60 epochs,',\n    'cosine annealing, ColorJitter, gradient clipping, CUDA AMP, validation macro-F1 checkpoint',\n    'selection and patience 12. Complete original primary evidence was reported unavailable',\n    'in the shared repository. Do not substitute this number into the controlled comparison.', '',\n    '## New experiment (actual saved results)',\n    'Adam, LR 0.001, weight decay 0.0001, batch 64, 30 epochs, seed 42, FP32.',\n    'No scheduler, early stopping, AMP or clipping. Checkpoint: minimum validation loss.',\n    f\"Validation accuracy: {100 * v['accuracy']:.2f}%; loss: {v['loss']:.6f}; macro-F1: {v['macro_f1']:.6f}\",\n    f\"Test accuracy: {100 * t['accuracy']:.2f}%; loss: {t['loss']:.6f}; macro-F1: {t['macro_f1']:.6f}\",\n    f\"Trainable parameters: {cost['parameters']:,}; Conv/Linear MACs/image: {cost['conv_linear_macs']:,}\",\n    f\"Training time: {timing['minutes']:.2f} minutes. Selected epoch: {best_epoch['epoch']}\",\n    f\"Split counts: { {name: ev['count'] for name, ev in cfg['split_evidence'].items()} }\",\n    f\"Canonical split confirmed by user: {cfg['canonical_splits_confirmed_by_user']}\",\n    f\"Shared preprocessing verified by user: {cfg['common_preprocessing_verified_by_user']}\",\n    f\"Environment matches: {cfg['environment_matches_target']}\",\n    f\"Actual versions: {cfg['actual_versions']}\",\n    f\"Artifacts: {run_dir.resolve()}\",\n    'See split_evidence.json for membership hashes, config.json for transforms and environment,',\n    'and the validation/test predictions, confusion matrices and learning_curves.png for evidence.',\n]\n(run_dir / 'experiment_report.md').write_text('\\n'.join(report_lines) + '\\n', encoding='utf-8')\nartifact_hashes = {path.name: hashlib.sha256(path.read_bytes()).hexdigest()\n                   for path in sorted(run_dir.iterdir()) if path.is_file() and path.name != 'artifact_checksums.json'}\n(run_dir / 'artifact_checksums.json').write_text(json.dumps(artifact_hashes, indent=2), encoding='utf-8')\nprint('\\n'.join(report_lines))\nprint('All required artifacts exist. Report and SHA256 checksums saved.')","metadata":{},"outputs":[],"execution_count":null}]}