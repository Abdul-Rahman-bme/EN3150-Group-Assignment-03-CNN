{"metadata":{"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"compact_update":{"source_sha256":"3de210814b9217e59ef7da8a9c874c06f75eebfcd664f93abdb65bb50c08aae1","architecture_cells_preserved":[20,21],"new_training_executed":false},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":1663377}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"compact-00","cell_type":"markdown","source":"# CompactEuroSAT: standardized training notebook\n\nRun cells from top to bottom. The **CompactEuroSAT and DSBlock architectures are unchanged**:\n11,466 trainable parameters and 3,882,784 Conv/Linear MACs per RGB 64×64 image.\nThis was originally developed as an additional compact CNN; it does not replace Model B (`model_c`).\n\n## Setup before Run All\n1. Attach the EuroSAT RGB dataset. `DATA_ROOT` must contain the ten class folders.\n2. Attach the **shared canonical** `train.csv`, `validation.csv`, and `test.csv` split files.\n   Set `CSV_DIR` below if they are in a different directory. Required counts: 18,900 / 4,050 / 4,050.\n   CSVs need a filename/path column; no random-split fallback is allowed.\n3. Use the shared experiment environment if available: Python 3.11.14, PyTorch 2.5.1,\n   torchvision 0.20.1, NumPy 1.26.4, Pillow 12.3.0. The environment cell reports actual\n   versions. Set `STRICT_ENVIRONMENT=True` to stop on any mismatch.\n4. The shared preprocessing implementation was not supplied. This notebook retains the\n   original train-only mean/std normalization, horizontal/vertical flips and quarter turns,\n   with ColorJitter removed. Compare these with the shared pipeline before treating results\n   as directly comparable. Set `COMMON_PIPELINE_VERIFIED=True` only after checking equivalence.\n   Similarly set `CANONICAL_SPLITS_CONFIRMED=True` only for the shared canonical files.\n\n## New training configuration\n`compact_eurosat`; Adam; LR 0.001; weight decay 0.0001; batch 64; exactly 30 epochs;\nseed 42; FP32; ordinary cross-entropy; no scheduler, early stopping, AMP or gradient clipping.\nSave `best_weights.pt` at **minimum validation loss**, then evaluate that checkpoint.\nAll results are generated by execution; this downloadable notebook contains no new trained results.\n\n## Historical experiment (keep separate)\n**Historical CompactEuroSAT result: 94.72% test accuracy**, from the original notebook protocol:\nbatch 128, maximum 60 epochs, cosine annealing, ColorJitter, gradient clipping,\nCUDA AMP and validation macro-F1 checkpoint selection (the original code also used patience 12).\nIts complete original run evidence was reported unavailable in the shared repository.\nThat result cannot replace Model B or serve as the new controlled comparison result.\nThe final cell writes a report from the actual new saved metrics and flags unresolved comparability checks.","metadata":{}},{"id":"compact-01","cell_type":"code","source":"# Depthwise Separable Convolution:\n\n# Normal convolution:\n# If input has 32 channels and output needs 64 channels:\n# - 64 filters\n# - each filter contains 32 sub-filters\n# - each sub-filter is 3x3\n\n# Parameters = 64 * 32 * 3 * 3\n#            = 18,432\n\n# Depthwise convolution:\n# - Use one 3x3 filter for each input channel\n# - 32 input channels -> 32 separate 3x3 filters\n\n# Parameters = 32 * 3 * 3\n#            = 288\n\n# Output after depthwise convolution still has 32 channels.\n\n# Pointwise convolution:\n# - Used to convert 32 channels into 64 channels\n# - Uses 64 filters\n# - each filter sees all 32 input channels\n# - each sub-filter is only 1x1\n\n# Parameters = 64 * 32 * 1 * 1\n#            = 2,048\n\n# Total parameters for depthwise separable convolution:\n# 288 + 2,048 = 2,336\n\n# Compared with normal convolution:\n# Normal Conv      = 18,432 parameters\n# Depthwise + 1x1 = 2,336 parameters\n\n# Key idea:\n# Normal Conv:\n#   64 filters, each with 32 separate 3x3 sub-filters\n\n# Depthwise Separable Conv:\n#   32 separate 3x3 filters\n#   +\n#   64 pointwise filters, each with 32 separate 1x1 sub-filters","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-02","cell_type":"code","source":"from pathlib import Path\nimport hashlib\nimport json\nimport random\nimport time\nimport platform\nimport os\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport PIL\nfrom PIL import Image\nimport torch\nfrom torch import nn\nfrom torch.utils.data import Dataset, DataLoader\nimport torchvision\nfrom torchvision import transforms as T\nfrom sklearn.metrics import (\n    accuracy_score, balanced_accuracy_score, classification_report,\n    confusion_matrix, ConfusionMatrixDisplay, precision_recall_fscore_support,\n)\nfrom tqdm.auto import tqdm","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-03","cell_type":"code","source":"SEED = 42\nBATCH_SIZE = 64\nEPOCHS = 30\nLR = 0.001\nWEIGHT_DECAY = 0.0001\nNUM_WORKERS = 0  # Portable in Jupyter on Windows as well as Kaggle/Linux.\nMODEL_NAME = 'compact_eurosat'\nRUN_NAME = 'compact_common_seed42_v1'\nDATA_ROOT = Path(os.environ.get('EUROSAT_DATA_ROOT',\n    '/kaggle/input/datasets/apollo2506/eurosat-dataset/EuroSAT'))\nCSV_DIR = Path(os.environ.get('EUROSAT_SPLIT_DIR', str(DATA_ROOT)))\nOUTPUT_ROOT = Path('/kaggle/working') if Path('/kaggle/working').is_dir() else Path.cwd() / 'outputs'\nOUT = OUTPUT_ROOT / 'custom_cnn' / RUN_NAME\nSTRICT_ENVIRONMENT = False  # True enforces all recorded target versions.\nCANONICAL_SPLITS_CONFIRMED = False  # Set True only for the shared canonical CSVs.\nCOMMON_PIPELINE_VERIFIED = False  # Set True only after checking the shared transforms/normalization.\nif OUT.exists() and any(OUT.iterdir()):\n    raise FileExistsError(f'{OUT} already contains artifacts. Use a fresh RUN_NAME to preserve evidence.')\nprint('Run artifacts:', OUT.resolve())","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-04","cell_type":"code","source":"def seed_everything(seed):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.benchmark = False\n    torch.backends.cudnn.deterministic = True\n    # Keep FP32 convolutions/matmul from using TF32 on compatible GPUs.\n    if torch.cuda.is_available():\n        torch.backends.cuda.matmul.allow_tf32 = False\n        torch.backends.cudnn.allow_tf32 = False","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-05","cell_type":"code","source":"seed_everything(SEED)\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\ntarget_versions = {'python': '3.11.14', 'torch': '2.5.1',\n                   'torchvision': '0.20.1', 'numpy': '1.26.4', 'pillow': '12.3.0'}\nactual_versions = {'python': platform.python_version(), 'torch': str(torch.__version__),\n                   'torchvision': str(torchvision.__version__),\n                   'numpy': np.__version__, 'pillow': PIL.__version__}\nversion_mismatches = {key: {'target': target, 'actual': actual_versions[key]}\n                      for key, target in target_versions.items()\n                      if actual_versions[key].split('+')[0] != target}\nenvironment_matches = not version_mismatches\nprint(json.dumps({'device': str(device), 'actual_versions': actual_versions,\n                  'version_mismatches': version_mismatches}, indent=2))\nif version_mismatches:\n    message = 'Environment differs from the shared experiment. Results are not yet verified comparable.'\n    if STRICT_ENVIRONMENT:\n        raise RuntimeError(message + ' Select the shared environment/kernel and restart.')\n    warnings.warn(message)\nif device.type == 'cuda':\n    print('GPU:', torch.cuda.get_device_name(0))","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-06","cell_type":"code","source":"CLASSES = sorted([\n    'AnnualCrop', 'Forest', 'HerbaceousVegetation', 'Highway',\n    'Industrial', 'Pasture', 'PermanentCrop', 'Residential',\n    'River', 'SeaLake'])","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-07","cell_type":"code","source":"class_to_idx = {name: i for i, name in enumerate(CLASSES)}\nK = len(CLASSES)\nEXTENSIONS = {'.jpg', '.jpeg', '.png'}","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-08","cell_type":"code","source":"if not DATA_ROOT.is_dir():\n    raise FileNotFoundError(f\"Dataset folder not found: {DATA_ROOT}\")\n\n\nrecords = []\n\nfor name in CLASSES:\n    class_folder = DATA_ROOT / name\n\n    if not class_folder.is_dir():\n        raise FileNotFoundError(f\"Class folder not found: {class_folder}\")\n\n    for path in sorted(class_folder.rglob(\"*\")):\n        if path.is_file() and path.suffix.lower() in EXTENSIONS:\n            records.append((str(path), class_to_idx[name]))\n\n# Create the image table\ndata = pd.DataFrame(records, columns=[\"path\", \"label\"])\n\n# Make sure all 10 classes contain images\nif data.empty or data[\"label\"].nunique() != K:\n    raise ValueError(\"Expected RGB images in all 10 class folders.\")\n\nprint(\"RGB root:\", DATA_ROOT)\nprint(\"Total images:\", len(data))\nprint(\"Number of classes:\", data[\"label\"].nunique())","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-09","cell_type":"code","source":"# Only supplied canonical manifests are accepted. Matching counts alone do not prove identity.\nSPLIT_MODE = 'canonical_csv'\nsplit_files = {name: CSV_DIR / filename for name, filename in {\n    'train': 'train.csv', 'validation': 'validation.csv', 'test': 'test.csv'}.items()}\nmissing = [str(path) for path in split_files.values() if not path.is_file()]\nif missing:\n    raise FileNotFoundError('Attach the shared canonical split CSVs and set CSV_DIR. Missing: '\n                            + ', '.join(missing) + '. No new random split will be created.')\nif not CANONICAL_SPLITS_CONFIRMED:\n    warnings.warn('Split membership has not been confirmed against the shared canonical experiment.')\nprint('Using supplied CSV splits:', CSV_DIR)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-10","cell_type":"code","source":"# Create lookup tables from the existing image table\nname_lookup = {}\n\nfor row in data.itertuples(index=False):\n    filename = Path(row.path).name\n    name_lookup.setdefault(filename, []).append(row.path)\n\nlabel_lookup = dict(zip(data[\"path\"], data[\"label\"]))","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-11","cell_type":"code","source":"def read_split(filename):\n    frame = pd.read_csv(CSV_DIR / filename)\n    columns = {str(c).lower().strip(): c for c in frame.columns}\n    aliases = ['filename', 'filepath', 'path', 'image', 'image_path']\n    column = next((columns[a] for a in aliases if a in columns), None)\n    if column is None:\n        raise ValueError(f'{filename}: expected a path column; found {list(frame.columns)}')\n    rows = []\n    for _, row in frame.iterrows():\n        value = str(row[column]).replace('\\\\', '/')\n        matches = name_lookup.get(value.split('/')[-1], [])\n        if len(matches) != 1:\n            raise ValueError(f'Missing or ambiguous image: {value}')\n        path = matches[0]\n        label = label_lookup[path]\n        for alias in ('classname', 'class_name'):\n            if alias in columns and str(row[columns[alias]]) != CLASSES[label]:\n                raise ValueError(f'Class name disagrees with folder: {value}')\n        rows.append((path, label))\n    return pd.DataFrame(rows, columns=['path', 'label'])","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-12","cell_type":"code","source":"train_df = read_split('train.csv')\nval_df = read_split('validation.csv')\ntest_df = read_split('test.csv')\nsplits = {'train': train_df, 'validation': val_df, 'test': test_df}\nexpected_counts = {'train': 18900, 'validation': 4050, 'test': 4050}\nseen_paths, seen_pixels = set(), {}\nsplit_evidence = {}\nfor split_name, frame in splits.items():\n    if len(frame) != expected_counts[split_name]:\n        raise ValueError(f'{split_name}: expected {expected_counts[split_name]}, found {len(frame)}')\n    if frame.path.duplicated().any() or seen_paths.intersection(frame.path):\n        raise ValueError(f'Repeated images or overlapping splits: {split_name}')\n    seen_paths.update(frame.path)\n    for path in frame.path:\n        with Image.open(path) as im:\n            if im.mode != 'RGB' or im.size != (64, 64):\n                raise ValueError(f'Expected RGB 64x64: {path}, {im.mode}, {im.size}')\n            digest = hashlib.sha256(im.tobytes()).hexdigest()\n        if digest in seen_pixels and seen_pixels[digest] != split_name:\n            raise ValueError('Identical image pixels occur across splits; resolve with the canonical split owner.')\n        seen_pixels[digest] = split_name\n    # Portable membership hash: independent of dataset mount paths and CSV row ordering.\n    members = sorted(f'{CLASSES[int(row.label)]}/{Path(row.path).name}'\n                     for row in frame.itertuples(index=False))\n    split_evidence[split_name] = {\n        'count': len(frame),\n        'source_csv': str(split_files[split_name].resolve()),\n        'csv_sha256': hashlib.sha256(split_files[split_name].read_bytes()).hexdigest(),\n        'membership_sha256': hashlib.sha256(('\\n'.join(members)).encode()).hexdigest(),\n    }\n    print(split_name, len(frame))\nif len(data) != 27000 or seen_paths != set(data.path):\n    raise ValueError('The splits must cover exactly the complete 27,000-image dataset.')\nOUT.mkdir(parents=True, exist_ok=True)\nfor split_name, frame in splits.items():\n    frame.to_csv(OUT / f'{split_name}_manifest.csv', index=False)\n(OUT / 'split_evidence.json').write_text(json.dumps(split_evidence, indent=2), encoding='utf-8')","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-13","cell_type":"code","source":"counts = pd.DataFrame({name: frame.label.value_counts().reindex(range(K), fill_value=0)\n                       for name, frame in splits.items()})\ncounts.index = CLASSES\ncounts.to_csv(OUT / 'class_counts.csv')\nif (counts.to_numpy() == 0).any():\n    raise ValueError('A class is missing from a split.')\nprint(counts.to_string())\nprint('Using ordinary unweighted cross-entropy for the standardized run.')\nax = counts.plot.bar(figsize=(12, 5))\nax.set(ylabel='Number of images', title='Class distribution by canonical CSV split')\nplt.xticks(rotation=35, ha='right')\nplt.tight_layout()\nplt.savefig(OUT / 'class_distribution.png', dpi=180)\nplt.show()","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-14","cell_type":"code","source":"# Train-only normalization, retained from the original notebook.\n# Check these statistics and the transforms below against the shared pipeline.\nchannel_sum = np.zeros(3, dtype=np.float64)\nchannel_sq = np.zeros(3, dtype=np.float64)\npixels = 0\nfor path in train_df.path:\n    with Image.open(path) as im:\n        array = np.asarray(im, dtype=np.float64) / 255.0\n    channel_sum += array.sum(axis=(0, 1))\n    channel_sq += (array ** 2).sum(axis=(0, 1))\n    pixels += array.shape[0] * array.shape[1]\nmean = channel_sum / pixels\nstd = np.sqrt(np.maximum(channel_sq / pixels - mean ** 2, 1e-12))\nprint('Training mean:', mean, '| std:', std)\nif not COMMON_PIPELINE_VERIFIED:\n    warnings.warn('Shared preprocessing equivalence is unverified; do not claim a controlled comparison yet.')","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-15","cell_type":"code","source":"class RandomQuarterTurn:\n    def __call__(self, image):\n        return image.rotate(90 * random.randrange(4))","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-16","cell_type":"code","source":"train_tf = T.Compose([\n    T.RandomHorizontalFlip(), T.RandomVerticalFlip(), RandomQuarterTurn(),\n    T.ToTensor(), T.Normalize(mean.tolist(), std.tolist()),\n])\neval_tf = T.Compose([T.ToTensor(), T.Normalize(mean.tolist(), std.tolist())])\nprint('Training transforms:', train_tf)\nprint('Evaluation transforms:', eval_tf)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-17","cell_type":"code","source":"class EuroSATDataset(Dataset):\n    def __init__(self, frame, transform):\n        self.paths = frame.path.tolist()\n        self.labels = frame.label.tolist()\n        self.transform = transform\n    def __len__(self):\n        return len(self.paths)\n    def __getitem__(self, index):\n        with Image.open(self.paths[index]) as im:\n            image = self.transform(im.convert('RGB'))\n        return image, self.labels[index]","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-18","cell_type":"code","source":"def seed_worker(worker_id):\n    worker_seed = torch.initial_seed() % (2 ** 32)\n    np.random.seed(worker_seed)\n    random.seed(worker_seed)\ndef make_loader(frame, transform, shuffle):\n    return DataLoader(\n        EuroSATDataset(frame, transform), batch_size=BATCH_SIZE,\n        shuffle=shuffle, num_workers=NUM_WORKERS,\n        pin_memory=(device.type == 'cuda'), worker_init_fn=seed_worker,\n        generator=torch.Generator().manual_seed(SEED))","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-19","cell_type":"code","source":"train_loader = make_loader(train_df, train_tf, True)\nval_loader = make_loader(val_df, eval_tf, False)\ntest_loader = make_loader(test_df, eval_tf, False)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-20","cell_type":"code","source":"class DSBlock(nn.Module):\n    def __init__(self, cin, cout, stride=1):\n        super().__init__()\n        self.skip = stride == 1 and cin == cout\n        self.layers = nn.Sequential(\n            nn.Conv2d(cin, cin, 3, stride, 1, groups=cin, bias=False),\n            nn.BatchNorm2d(cin), nn.ReLU(inplace=True),\n            nn.Conv2d(cin, cout, 1, bias=False),\n            nn.BatchNorm2d(cout),\n        )\n        self.relu = nn.ReLU(inplace=True)\n    def forward(self, x):\n        y = self.layers(x)\n        if self.skip:\n            y = y + x\n        return self.relu(y)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-21","cell_type":"code","source":"class CompactEuroSAT(nn.Module):\n    def __init__(self, num_classes=10):\n        super().__init__()\n        self.features = nn.Sequential(\n            nn.Conv2d(3, 16, 3, padding=1, bias=False),\n            nn.BatchNorm2d(16), nn.ReLU(inplace=True),\n            DSBlock(16, 32, 2),  # 32 x 32 x 32\n            DSBlock(32, 48, 2),  # 48 x 16 x 16\n            DSBlock(48, 48),     # Residual; 48 x 16 x 16\n            DSBlock(48, 80, 2),  # 80 x 8 x 8\n        )\n        self.head = nn.Sequential(\n            nn.AdaptiveAvgPool2d(1), nn.Flatten(),\n            nn.Dropout(0.10), nn.Linear(80, num_classes),\n        )\n    def forward(self, x):\n        return self.head(self.features(x))","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-22","cell_type":"code","source":"seed_everything(SEED)\nmodel = CompactEuroSAT(K).to(device=device, dtype=torch.float32)\nparams = sum(p.numel() for p in model.parameters() if p.requires_grad)\nassert params == 11466, 'The unchanged 10-class model must have 11,466 trainable parameters.'\nwith torch.no_grad():\n    model.eval()\n    assert model(torch.zeros(2, 3, 64, 64, device=device)).shape == (2, K)\nassert all(p.dtype == torch.float32 for p in model.parameters())\nprint(f'Trainable parameters: {params:,}; FP32 parameter bytes: {4 * params:,}')","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-23","cell_type":"code","source":"#Count convolution + linear MACs for ONE 64x64 image.\n# BN, activations, pooling, additions and memory access are excluded.\nmacs = 0\ndef count_macs(layer, inputs, output):\n    global macs\n    if isinstance(layer, nn.Conv2d):\n        kh, kw = layer.kernel_size\n        macs += output.numel() * (layer.in_channels // layer.groups) * kh * kw\n    elif isinstance(layer, nn.Linear):\n        macs += output.numel() * layer.in_features\nhooks = [m.register_forward_hook(count_macs) for m in model.modules()\n         if isinstance(m, (nn.Conv2d, nn.Linear))]\nwith torch.inference_mode():\n    model(torch.zeros(1, 3, 64, 64, device=device))\nfor hook in hooks:\n    hook.remove()\nassert macs == 3882784\nprint(f'Conv + linear MACs/image: {macs:,}')","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-24","cell_type":"code","source":"run_dir = OUT\ncriterion = nn.CrossEntropyLoss()  # Ordinary unweighted CE, mean reduction.\noptimizer = torch.optim.Adam(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\nprint('Adam | LR:', LR, '| weight decay:', WEIGHT_DECAY, '| batch:', BATCH_SIZE,\n      '| epochs:', EPOCHS, '| FP32 | no scheduler/early stopping/AMP/clipping')","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-25","cell_type":"code","source":"comparison_ready = bool(environment_matches and CANONICAL_SPLITS_CONFIRMED and COMMON_PIPELINE_VERIFIED)\nconfig = {\n    'model': MODEL_NAME, 'class': 'CompactEuroSAT', 'run_name': RUN_NAME,\n    'classes': CLASSES, 'mean': mean.tolist(), 'std': std.tolist(),\n    'seed': SEED, 'parameters': params, 'conv_linear_macs': macs,\n    'batch_size': BATCH_SIZE, 'epochs': EPOCHS, 'optimizer': 'Adam',\n    'lr': LR, 'weight_decay': WEIGHT_DECAY, 'loss': 'unweighted_cross_entropy',\n    'precision': 'FP32', 'scheduler': None, 'early_stopping': False,\n    'gradient_clipping': None, 'amp': False, 'checkpoint_rule': 'minimum_validation_loss',\n    'input': {'mode': 'RGB', 'size': [64, 64]},\n    'train_transforms': str(train_tf), 'eval_transforms': str(eval_tf),\n    'normalization_source': 'training_split_only', 'split_mode': SPLIT_MODE,\n    'split_evidence': split_evidence, 'device': str(device),\n    'target_versions': target_versions, 'actual_versions': actual_versions,\n    'environment_matches_target': environment_matches,\n    'canonical_splits_confirmed_by_user': CANONICAL_SPLITS_CONFIRMED,\n    'common_preprocessing_verified_by_user': COMMON_PIPELINE_VERIFIED,\n    'comparison_ready': comparison_ready, 'artifact_location': str(OUT.resolve()),\n    'historical_result': {'test_accuracy_percent': 94.72,\n        'protocol': 'original notebook; distinct from this run',\n        'complete_primary_artifacts_available_in_shared_repository': False},\n}\n(OUT / 'config.json').write_text(json.dumps(config, indent=2), encoding='utf-8')\nprint('Configuration saved. Verified comparison-ready:', comparison_ready)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-26","cell_type":"code","source":"history = []\nbest_val_loss = float('inf')\ntraining_start = time.perf_counter()\nfor epoch in range(1, EPOCHS + 1):\n    epoch_start = time.perf_counter()\n    stats = {}\n    with tqdm(total=len(train_loader) + len(val_loader),\n              desc=f'Epoch {epoch:02d}/{EPOCHS}', leave=True) as bar:\n        for phase, loader in [('train', train_loader), ('val', val_loader)]:\n            training = phase == 'train'\n            model.train(training)\n            loss_sum = 0.0\n            correct = total = 0\n            truth, predicted = [], []\n            for images, labels in loader:\n                images = images.to(device=device, dtype=torch.float32, non_blocking=True)\n                labels = labels.to(device, non_blocking=True)\n                if training:\n                    optimizer.zero_grad(set_to_none=True)\n                with torch.set_grad_enabled(training):\n                    logits = model(images)\n                    loss = criterion(logits, labels)\n                    if training:\n                        loss.backward()\n                        optimizer.step()\n                pred = logits.argmax(dim=1)\n                loss_sum += loss.detach().item() * labels.numel()\n                correct += (pred == labels).sum().item()\n                total += labels.numel()\n                truth.extend(labels.detach().cpu().tolist())\n                predicted.extend(pred.detach().cpu().tolist())\n                bar.set_postfix(phase=phase, loss=f'{loss_sum / total:.4f}',\n                                accuracy=f'{correct / total:.4f}', refresh=False)\n                bar.update(1)\n            precision, recall, f1, _ = precision_recall_fscore_support(\n                truth, predicted, labels=list(range(K)), average='macro', zero_division=0)\n            stats.update({f'{phase}_loss': loss_sum / total,\n                          f'{phase}_acc': correct / total,\n                          f'{phase}_precision': precision,\n                          f'{phase}_recall': recall, f'{phase}_f1': f1})\n    stats.update(epoch=epoch, lr=optimizer.param_groups[0]['lr'],\n                 epoch_seconds=time.perf_counter() - epoch_start)\n    history.append(stats)\n    pd.DataFrame(history).to_csv(run_dir / 'history.csv', index=False)\n    if stats['val_loss'] < best_val_loss:\n        best_val_loss = stats['val_loss']\n        torch.save(model.state_dict(), run_dir / 'best_weights.pt')\n        best_epoch = {'epoch': epoch, 'validation_loss': best_val_loss,\n                      'validation_accuracy': stats['val_acc'],\n                      'validation_macro_f1': stats['val_f1'],\n                      'checkpoint_rule': 'minimum_validation_loss'}\n        (run_dir / 'best_epoch.json').write_text(json.dumps(best_epoch, indent=2), encoding='utf-8')\ntraining_seconds = time.perf_counter() - training_start\nassert len(history) == 30\n(run_dir / 'training_time.json').write_text(json.dumps({\n    'seconds': training_seconds, 'minutes': training_seconds / 60,\n    'scope': '30 epochs of training, validation and checkpoint/history writes; excludes setup and final evaluation'\n}, indent=2), encoding='utf-8')\nprint('Completed all 30 epochs. Best checkpoint:', best_epoch)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-27","cell_type":"code","source":"# %% 10. Raw and smoothed learning curves (smoothing is display-only)\nhist = pd.DataFrame(history)\nfig, axes = plt.subplots(1, 3, figsize=(16, 4))\nfor ax, metric in zip(axes, ['loss', 'acc', 'f1']):\n    for phase, color in [('train', 'tab:blue'), ('val', 'tab:orange')]:\n        values = hist[f'{phase}_{metric}']\n        ax.plot(hist.epoch, values, color=color, alpha=0.25,\n                label=f'{phase} raw')\n        smooth = values.ewm(alpha=0.30, adjust=False).mean()\n        ax.plot(hist.epoch, smooth, color=color,\n                label=f'{phase} EMA')\n    ax.set(xlabel='Epoch', ylabel=metric, title=metric)\n    ax.grid(alpha=0.2)\n    ax.legend(fontsize=8)\nfig.tight_layout()\nfig.savefig(run_dir / 'learning_curves.png', dpi=180)\nplt.show()","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-28","cell_type":"code","source":"# Load only the checkpoint selected by validation loss. Evaluate test once.\nmodel.load_state_dict(torch.load(run_dir / 'best_weights.pt', map_location=device, weights_only=True))\nmodel.eval()\n\ndef evaluate_and_save(loader, frame, split_name):\n    y_true, y_pred, probabilities = [], [], []\n    loss_sum = 0.0\n    with torch.inference_mode():\n        for images, labels in loader:\n            labels_device = labels.to(device)\n            logits = model(images.to(device=device, dtype=torch.float32, non_blocking=True))\n            loss_sum += criterion(logits, labels_device).item() * labels.numel()\n            probabilities.extend(logits.softmax(1).cpu().numpy())\n            y_true.extend(labels.tolist())\n            y_pred.extend(logits.argmax(1).cpu().tolist())\n    report = classification_report(y_true, y_pred, labels=list(range(K)),\n        target_names=CLASSES, zero_division=0, output_dict=True)\n    metrics = {'loss': loss_sum / len(y_true), 'accuracy': accuracy_score(y_true, y_pred),\n        'balanced_accuracy': balanced_accuracy_score(y_true, y_pred),\n        'macro_precision': report['macro avg']['precision'],\n        'macro_recall': report['macro avg']['recall'],\n        'macro_f1': report['macro avg']['f1-score'],\n        'weighted_f1': report['weighted avg']['f1-score'],\n        'num_images': len(y_true), 'checkpoint_epoch': best_epoch['epoch']}\n    (run_dir / f'{split_name}_metrics.json').write_text(json.dumps(metrics, indent=2), encoding='utf-8')\n    pd.DataFrame(report).T.to_csv(run_dir / f'{split_name}_classification_report.csv')\n    predictions_df = frame.reset_index(drop=True).copy()\n    predictions_df['true_class'] = [CLASSES[i] for i in y_true]\n    predictions_df['predicted_label'] = y_pred\n    predictions_df['predicted_class'] = [CLASSES[i] for i in y_pred]\n    for i, name in enumerate(CLASSES):\n        predictions_df[f'prob_{name}'] = np.asarray(probabilities)[:, i]\n    predictions_df.to_csv(run_dir / f'{split_name}_predictions.csv', index=False)\n    fig, axes = plt.subplots(1, 2, figsize=(17, 7))\n    for ax, normalization, title in zip(axes, [None, 'true'], ['Counts', 'Recall']):\n        cm = confusion_matrix(y_true, y_pred, labels=list(range(K)), normalize=normalization)\n        pd.DataFrame(cm, index=CLASSES, columns=CLASSES).to_csv(\n            run_dir / f'{split_name}_confusion_{normalization}.csv')\n        ConfusionMatrixDisplay(cm, display_labels=CLASSES).plot(ax=ax,\n            xticks_rotation=90, cmap='Blues', colorbar=False,\n            values_format='d' if normalization is None else '.2f')\n        ax.set_title(f'{split_name}: {title}')\n    fig.tight_layout()\n    fig.savefig(run_dir / f'{split_name}_confusion_matrices.png', dpi=180)\n    plt.show()\n    print(split_name, json.dumps(metrics, indent=2))\n    return metrics\n\nvalidation_metrics = evaluate_and_save(val_loader, val_df, 'validation')\nif not np.isclose(validation_metrics['loss'], best_epoch['validation_loss'], rtol=1e-5, atol=1e-7):\n    raise RuntimeError('Reloaded checkpoint validation loss does not match the selected epoch.')\ntest_metrics = evaluate_and_save(test_loader, test_df, 'test')","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-29","cell_type":"code","source":"# Display saved results without evaluating the test set a second time.\nsaved_validation = json.loads((run_dir / 'validation_metrics.json').read_text())\nsaved_test = json.loads((run_dir / 'test_metrics.json').read_text())\nfor name, metrics in [('Validation', saved_validation), ('Test', saved_test)]:\n    print(f\"{name}: accuracy={metrics['accuracy'] * 100:.2f}%, \"\n          f\"loss={metrics['loss']:.6f}, macro-F1={metrics['macro_f1']:.6f}\")\nprint(f'Training time: {training_seconds / 60:.2f} minutes')\nprint('Historical accuracy (separate protocol): 94.72%')\nprint('Verified comparison-ready:', comparison_ready)","metadata":{},"outputs":[],"execution_count":null},{"id":"compact-30","cell_type":"code","source":"#\n \n%\n%\n \n1\n2\n.\n \nB\na\nt\nc\nh\n-\no\nn\ne\n \nm\no\nd\ne\nl\n-\no\nn\nl\ny\n \nl\na\nt\ne\nn\nc\ny\n \na\nn\nd\n \nc\nh\ne\nc\nk\np\no\ni\nn\nt\n \ns\ni\nz\ne\n\n#\n \nI\nn\nc\nl\nu\nd\ne\ns\n \nn\ne\ni\nt\nh\ne\nr\n \np\nr\ne\np\nr\no\nc\ne\ns\ns\ni\nn\ng\n \nn\no\nr\n \nh\no\ns\nt\n-\nt\no\n-\nd\ne\nv\ni\nc\ne\n \nt\nr\na\nn\ns\nf\ne\nr\ns\n.\n\nd\nu\nm\nm\ny\n \n=\n \nt\no\nr\nc\nh\n.\nr\na\nn\nd\nn\n(\n1\n,\n \n3\n,\n \n6\n4\n,\n \n6\n4\n,\n \nd\ne\nv\ni\nc\ne\n=\nd\ne\nv\ni\nc\ne\n)\n\nd\ne\nf\n \ns\ny\nn\nc\n(\n)\n:\n\n \n \n \n \ni\nf\n \nd\ne\nv\ni\nc\ne\n.\nt\ny\np\ne\n \n=\n=\n \n'\nc\nu\nd\na\n'\n:\n\n \n \n \n \n \n \n \n \nt\no\nr\nc\nh\n.\nc\nu\nd\na\n.\ns\ny\nn\nc\nh\nr\no\nn\ni\nz\ne\n(\n)\n\nw\ni\nt\nh\n