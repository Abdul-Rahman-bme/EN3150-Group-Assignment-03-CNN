ers for depthwise separable convolution:\n# 288 + 2,048 = 2,336\n\n# Compared with normal convolution:\n# Normal Conv      = 18,432 parameters\n# Depthwise + 1x1 = 2,336 parameters\n\n# Key idea:\n# Normal Conv:\n#   64 filters, each with 32 separate 3x3 sub-filters\n\n# Depthwise Separable Conv:\n#   32 separate 3x3 filters\n#   +\n#   64 pointwise filters, each with 32 separate 1x1 sub-filters","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T19:23:44.089957Z","iopub.execute_input":"2026-10-17T19:23:44.091095Z","iopub.status.idle":"2026-10-17T19:23:44.097204Z","shell.execute_reply.started":"2026-10-17T19:23:44.091052Z","shell.execute_reply":"2026-10-17T19:23:44.096214Z"}},"outputs":[],"execution_count":1},{"id":"compact-02","cell_type":"code","source":"from pathlib import Path\nimport hashlib\nimport json\nimport random\nimport time\nimport platform\nimport os\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport PIL\nfrom PIL import Image\nimport torch\nfrom torch import nn\nfrom torch.utils.data import Dataset, DataLoader\nimport torchvision\nfrom torchvision import transforms as T\nfrom sklearn.metrics import (\n    accuracy_score, balanced_accuracy_score, classification_report,\n    confusion_matrix, ConfusionMatrixDisplay, precision_recall_fscore_support,\n)\nfrom tqdm.auto import tqdm","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T19:24:14.804279Z","iopub.execute_input":"2026-10-17T19:24:14.804832Z","iopub.status.idle":"2026-10-17T19:24:28.345448Z","shell.execute_reply.started":"2026-10-17T19:24:14.804809Z","shell.execute_reply":"2026-10-17T19:24:28.344893Z"}},"outputs":[],"execution_count":1},{"id":"compact-03","cell_type":"code","source":"SEED = 42\nBATCH_SIZE = 64\nEPOCHS = 30\nLR = 0.001\nWEIGHT_DECAY = 0.0001\nNUM_WORKERS = 0  # Portable in Jupyter on Windows as well as Kaggle/Linux.\nMODEL_NAME = 'compact_eurosat'\nRUN_NAME = 'compact_common_seed42_v1'\nDATA_R